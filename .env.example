# OpenAI API key — used by the default judge model.
# Get one at https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...

# Optional: use Anthropic (Claude) as the judge instead of OpenAI.
# JUDGE_PROVIDER=anthropic
# ANTHROPIC_API_KEY=sk-ant-...

# Optional: override the default judge model id.
# (default: gpt-4o for openai, claude-sonnet-4-5 for anthropic)
# JUDGE_MODEL=gpt-4o
